/* pages/record-detail/record-detail.wxss */

.page {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 0 48rpx;
}

.placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24rpx;
}

.placeholder-title {
    font-size: 40rpx;
    font-weight: 700;
    color: #e6f5ef;
}

.placeholder-desc {
    font-size: 28rpx;
    color: rgba(214, 236, 227, 0.7);
}

.placeholder-hint {
    font-size: 24rpx;
    color: rgba(214, 236, 227, 0.4);
    margin-top: 16rpx;
}
