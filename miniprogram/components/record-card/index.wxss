/* components/record-card/index.wxss */

.record-card {
    padding: 28rpx;
    border-radius: 36rpx;
    background: rgba(18, 31, 28, 0.92);
    border: 2rpx solid rgba(72, 110, 96, 0.6);
    display: flex;
    flex-direction: column;
    gap: 24rpx;
    box-shadow: 0 20rpx 44rpx rgba(6, 16, 13, 0.45);
}

/* 头部 */
.record-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20rpx;
}

.record-title {
    display: flex;
    flex-direction: column;
    gap: 10rpx;
    flex: 1;
    min-width: 0;
}

.record-name {
    font-size: 30rpx;
    font-weight: 600;
    color: #e6f5ef;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.record-meta {
    display: flex;
    align-items: center;
    gap: 14rpx;
    color: rgba(218, 239, 231, 0.65);
    font-size: 24rpx;
}

.record-mode {
    padding: 6rpx 18rpx;
    border-radius: 999rpx;
    border: 2rpx solid rgba(72, 120, 102, 0.6);
    background: rgba(27, 46, 40, 0.85);
    color: rgba(210, 238, 227, 0.8);
    font-size: 22rpx;
    flex-shrink: 0;
}

.record-dot {
    width: 8rpx;
    height: 8rpx;
    border-radius: 50%;
    background: rgba(210, 238, 227, 0.4);
    flex-shrink: 0;
}

.record-time {
    font-size: 22rpx;
    color: rgba(218, 239, 231, 0.65);
}

.record-status {
    padding: 8rpx 22rpx;
    border-radius: 999rpx;
    border: 2rpx solid rgba(90, 150, 120, 0.55);
    background: rgba(24, 44, 37, 0.85);
    color: rgba(210, 238, 227, 0.85);
    font-size: 22rpx;
    white-space: nowrap;
    flex-shrink: 0;
}

/* 内容 */
.record-body {
    display: flex;
    flex-direction: column;
    gap: 16rpx;
}

.record-target {
    font-size: 24rpx;
    color: rgba(218, 239, 231, 0.55);
}

.record-players {
    display: flex;
    flex-direction: column;
    gap: 14rpx;
}

/* 胜者行 */
.winner-row {
    display: flex;
    align-items: center;
    gap: 16rpx;
    padding: 14rpx 22rpx;
    border-radius: 24rpx;
    border: 2rpx solid rgba(94, 170, 132, 0.7);
    background: rgba(35, 76, 60, 0.6);
    color: #e9fbf1;
}

.winner-label {
    padding: 4rpx 14rpx;
    border-radius: 999rpx;
    border: 2rpx solid rgba(112, 208, 152, 0.6);
    background: rgba(24, 52, 41, 0.8);
    font-size: 22rpx;
    color: rgba(210, 238, 227, 0.85);
    flex-shrink: 0;
}

.winner-name {
    flex: 1;
    font-size: 26rpx;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.winner-score {
    padding: 4rpx 14rpx;
    border-radius: 999rpx;
    border: 2rpx solid rgba(112, 208, 152, 0.6);
    background: rgba(25, 58, 45, 0.9);
    font-size: 24rpx;
    font-weight: 600;
    flex-shrink: 0;
}

/* 球员行 */
.participants-row {
    display: flex;
    align-items: center;
    gap: 14rpx;
    font-size: 24rpx;
    color: rgba(214, 236, 227, 0.7);
}

.participants-label {
    flex-shrink: 0;
    color: rgba(214, 236, 227, 0.55);
}

.participants-names {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
