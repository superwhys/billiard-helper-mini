<!--pages/create-room/create-room.wxml-->
<view class="page">
    <scroll-view class="scroll-area" scroll-y enhanced show-scrollbar="{{false}}" bindscroll="handleCloseSwipe">

        <!-- 当前玩法 -->
        <view class="section">
            <view class="section-head">
                <text class="section-title">当前玩法</text>
            </view>
            <view class="mode-card">
                <view class="mode-badge">{{modeBadge}}</view>
                <view class="mode-info">
                    <text class="mode-title">{{modeTitle}}</text>
                    <text class="mode-desc">{{modeDesc}}</text>
                    <text class="mode-meta">{{modeMeta}}</text>
                </view>
            </view>
        </view>

        <!-- 房间 ID -->
        <view class="room-id-row">
            <text class="room-id-label">房间 ID</text>
            <text class="room-id-value">{{matchIdText}}</text>
        </view>

        <!-- 房间名称 -->
        <view class="form-section">
            <text class="field-label">房间名称</text>
            <input
                class="text-input"
                type="text"
                placeholder="请输入房间名称"
                value="{{roomName}}"
                bindinput="handleNameInput"
                bindblur="handleNameBlur"
            />
        </view>

        <!-- 目标局数（九球追分不显示） -->
        <view wx:if="{{!isNineBall}}" class="form-section">
            <view class="field-head">
                <text class="field-label">目标局数</text>
                <text class="field-hint">BO(2n-1)</text>
            </view>
            <view class="chip-group">
                <view
                    wx:for="{{targetOptions}}"
                    wx:key="*this"
                    class="chip {{item === targetScore ? 'is-active' : ''}}"
                    data-option="{{item}}"
                    bindtap="handleSelectTarget"
                >{{item}}</view>
                <view class="chip custom-chip">
                    <text class="custom-chip-label">自定义</text>
                    <input
                        class="chip-input"
                        type="number"
                        value="{{targetScore}}"
                        bindinput="handleTargetInput"
                        bindblur="handleTargetBlur"
                    />
                </view>
            </view>
        </view>

        <!-- 分数配置（九球专用） -->
        <view wx:if="{{isNineBall}}" class="score-config-section">
            <view class="score-config-trigger" bindtap="handleToggleScoreConfig">
                <text class="field-label">分数配置</text>
                <text class="score-config-chevron {{scoreConfigExpanded ? 'is-expanded' : ''}}">›</text>
            </view>
            <view wx:if="{{scoreConfigExpanded}}" class="score-config-list">
                <view class="score-config-row" wx:for="{{scoreItems}}" wx:key="key">
                    <text class="score-config-label">{{item.label}}</text>
                    <input
                        class="score-config-input"
                        type="number"
                        value="{{item.value}}"
                        data-key="{{item.key}}"
                        bindinput="handleScoreInput"
                        bindblur="handleScoreBlur"
                    />
                </view>
            </view>
        </view>

        <!-- 球员列表 -->
        <view class="player-section">
            <view class="field-head">
                <text class="field-label">球员（1-{{modeMaxPlayers}}人）</text>
                <view class="add-link {{!canAddPlayer ? 'is-disabled' : ''}}" bindtap="handleOpenAdd">+ 添加</view>
            </view>
            <view class="player-list">
                <view
                    class="player-swipe"
                    wx:for="{{players}}"
                    wx:key="id"
                    data-player-id="{{item.id}}"
                    bindtouchstart="onPlayerTouchStart"
                    bindtouchend="onPlayerTouchEnd"
                >
                    <view class="player-slide {{swipedPlayerId === item.id ? 'is-swiped' : ''}}">
                        <view class="player-card">
                            <view class="player-avatar">玩</view>
                            <text class="player-name">{{item.nick_name}}</text>
                            <view
                                class="player-edit"
                                data-player-id="{{item.id}}"
                                data-player-name="{{item.nick_name}}"
                                catchtap="handleOpenEdit"
                            >编辑</view>
                        </view>
                        <view
                            class="player-delete"
                            data-player-id="{{item.id}}"
                            catchtap="handleDeletePlayer"
                        >删除</view>
                    </view>
                </view>
            </view>
            <text wx:if="{{!canAddPlayer}}" class="limit-hint">已达到当前玩法的最大人数</text>
        </view>

        <!-- 操作按钮 -->
        <view class="action-bar">
            <view class="primary-button" bindtap="handleStartGame">开始对局</view>
            <view class="danger-button {{isDeletingMatch ? 'is-disabled' : ''}}" bindtap="handleOpenDeleteMatch">删除比赛</view>
        </view>

        <view class="bottom-spacer"></view>
    </scroll-view>

    <!-- 添加球员弹窗 -->
    <view wx:if="{{showAddModal}}" class="modal-mask" bindtap="handleCloseAdd">
        <view class="modal-card" catchtap="">
            <text class="modal-title">添加球员</text>
            <input
                class="modal-input"
                type="text"
                placeholder="请输入球员名称"
                value="{{addingName}}"
                bindinput="handleAddNameInput"
                focus="{{showAddModal}}"
            />
            <view class="modal-actions">
                <view class="modal-button ghost" bindtap="handleCloseAdd">取消</view>
                <view class="modal-button" bindtap="handleConfirmAdd">确定</view>
            </view>
        </view>
    </view>

    <!-- 编辑球员弹窗 -->
    <view wx:if="{{showEditModal}}" class="modal-mask" bindtap="handleCloseEdit">
        <view class="modal-card" catchtap="">
            <text class="modal-title">修改球员名称</text>
            <input
                class="modal-input"
                type="text"
                placeholder="请输入球员名称"
                value="{{editingName}}"
                bindinput="handleEditNameInput"
                focus="{{showEditModal}}"
            />
            <view class="modal-actions">
                <view class="modal-button ghost" bindtap="handleCloseEdit">取消</view>
                <view class="modal-button" bindtap="handleSaveEdit">保存</view>
            </view>
        </view>
    </view>

    <!-- 删除对局弹窗 -->
    <view wx:if="{{showDeleteModal}}" class="modal-mask" bindtap="handleCloseDeleteMatch">
        <view class="modal-card" catchtap="">
            <text class="modal-title">删除比赛</text>
            <text class="modal-desc">确定要删除当前比赛吗？删除后无法恢复。</text>
            <view class="modal-actions">
                <view class="modal-button ghost" bindtap="handleCloseDeleteMatch">取消</view>
                <view class="modal-button {{isDeletingMatch ? 'is-disabled' : ''}}" bindtap="handleConfirmDeleteMatch">确认删除</view>
            </view>
        </view>
    </view>
</view>
