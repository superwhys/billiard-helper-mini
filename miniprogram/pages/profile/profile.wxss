/* pages/profile/profile.wxss */
.page {
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: linear-gradient(180deg, #0c1e17 0%, #0a1a14 50%, #081410 100%);
}

.scroll-area {
    flex: 1;
    height: 100%;
    padding: 20rpx 36rpx 0;
}

/* 用户信息卡片 */
.profile-card {
    padding: 28rpx;
    border-radius: 36rpx;
    background: rgba(19, 33, 29, 0.95);
    border: 2rpx solid rgba(72, 108, 94, 0.6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24rpx;
    box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.25);
    margin-bottom: 32rpx;
}

.profile-info {
    display: flex;
    align-items: center;
    gap: 24rpx;
}

.profile-avatar {
    width: 88rpx;
    height: 88rpx;
    border-radius: 50%;
    background: rgba(44, 112, 79, 0.9);
    border: 2rpx solid rgba(98, 214, 151, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #e7f5f1;
    font-weight: 700;
    font-size: 34rpx;
    flex-shrink: 0;
}

.profile-text {
    display: flex;
    flex-direction: column;
    gap: 8rpx;
}

.profile-name {
    font-size: 30rpx;
    font-weight: 600;
    color: #e6f5ef;
}

.profile-desc {
    font-size: 22rpx;
    color: rgba(218, 239, 231, 0.6);
}

.profile-action {
    padding: 14rpx 28rpx;
    border-radius: 999rpx;
    background: rgba(52, 92, 75, 0.9);
    color: #dff3e9;
    font-size: 24rpx;
    font-weight: 600;
    flex-shrink: 0;
}

.profile-action:active {
    opacity: 0.8;
}

/* 设置区域 */
.settings-section {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
    margin-bottom: 32rpx;
}

.section-title {
    font-size: 28rpx;
    font-weight: 600;
    color: rgba(231, 245, 241, 0.75);
}

.settings-card {
    border-radius: 36rpx;
    border: 2rpx solid rgba(70, 108, 94, 0.6);
    background: rgba(19, 33, 29, 0.9);
    overflow: hidden;
}

.settings-item {
    padding: 24rpx 28rpx;
    display: flex;
    align-items: center;
    gap: 24rpx;
    border-bottom: 2rpx solid rgba(42, 64, 57, 0.8);
}

.settings-item:last-child {
    border-bottom: none;
}

.item-icon {
    width: 64rpx;
    height: 64rpx;
    border-radius: 20rpx;
    background: rgba(28, 50, 43, 0.9);
    border: 2rpx solid rgba(72, 108, 94, 0.6);
    position: relative;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

.item-icon.help::after {
    content: '?';
    font-size: 28rpx;
    font-weight: 700;
    color: rgba(214, 236, 227, 0.7);
}

.item-icon.about::after {
    content: 'i';
    font-size: 28rpx;
    font-weight: 700;
    font-style: italic;
    color: rgba(214, 236, 227, 0.7);
}

.item-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6rpx;
}

.item-title {
    font-size: 28rpx;
    font-weight: 600;
    color: #e6f5ef;
}

.item-desc {
    font-size: 22rpx;
    color: rgba(218, 239, 231, 0.55);
}

.item-arrow {
    color: rgba(214, 236, 227, 0.6);
    font-size: 32rpx;
}

/* 登录按钮 */
.login-button {
    width: 100%;
    padding: 28rpx 0;
    border-radius: 999rpx;
    border: 2rpx solid rgba(98, 214, 151, 0.7);
    background: rgba(44, 112, 79, 0.9);
    color: #e7f5f1;
    font-size: 28rpx;
    font-weight: 600;
    text-align: center;
    margin-bottom: 32rpx;
}

.login-button:active {
    opacity: 0.8;
}

.login-button.is-disabled {
    opacity: 0.6;
}

/* 退出登录 */
.logout-button {
    width: 100%;
    padding: 28rpx 0;
    border-radius: 999rpx;
    border: 2rpx solid rgba(170, 84, 84, 0.7);
    background: rgba(63, 24, 24, 0.9);
    color: #f8d7d7;
    font-size: 28rpx;
    font-weight: 600;
    text-align: center;
}

.logout-button:active {
    opacity: 0.8;
}

.logout-button.is-disabled {
    opacity: 0.6;
}

/* 弹窗 */
.modal-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(8, 12, 11, 0.72);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48rpx;
    z-index: 200;
}

.modal-card {
    width: 100%;
    max-width: 600rpx;
    border-radius: 40rpx;
    padding: 36rpx;
    background: rgba(19, 33, 29, 0.95);
    border: 2rpx solid rgba(72, 108, 94, 0.7);
    box-shadow: 0 32rpx 64rpx rgba(0, 0, 0, 0.35);
    display: flex;
    flex-direction: column;
    gap: 24rpx;
}

.modal-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #e6f5ef;
}

.name-input {
    width: 100%;
    min-height: 88rpx;
    line-height: 88rpx;
    padding: 0 28rpx;
    border-radius: 24rpx;
    border: 2rpx solid rgba(72, 108, 94, 0.6);
    background: rgba(16, 28, 24, 0.9);
    color: #e7f5f1;
    font-size: 28rpx;
}

.modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 20rpx;
    margin-top: 24rpx;
}

.modal-button {
    padding: 16rpx 36rpx;
    border-radius: 999rpx;
    font-size: 26rpx;
    font-weight: 600;
}

.modal-button.ghost {
    background: rgba(40, 60, 52, 0.6);
    color: rgba(231, 245, 241, 0.85);
}

.modal-button.primary {
    background: rgba(52, 92, 75, 0.95);
    color: #e6f5ef;
}

/* 重置 button 默认样式 */
button.modal-button {
    margin: 0;
    border: none;
    line-height: inherit;
}

button.modal-button::after {
    display: none;
}

.modal-button.is-disabled {
    opacity: 0.6;
}

/* 底部留白 */
.bottom-spacer {
    height: 180rpx;
}
