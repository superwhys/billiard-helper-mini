<!--pages/profile/profile.wxml-->
<view class="page">
    <scroll-view class="scroll-area" scroll-y enhanced show-scrollbar="{{false}}">
        <!-- 用户信息卡片 -->
        <view class="profile-card">
            <view class="profile-info">
                <view class="profile-avatar">{{avatarLetter}}</view>
                <view class="profile-text">
                    <text class="profile-name">{{displayName}}</text>
                    <text class="profile-desc">点击右侧按钮可修改</text>
                </view>
            </view>
            <view class="profile-action" bindtap="openEdit">修改</view>
        </view>

        <!-- 常用设置 -->
        <view class="settings-section">
            <text class="section-title">常用设置</text>
            <view class="settings-card">
                <view class="settings-item" wx:for="{{settings}}" wx:key="title">
                    <view class="item-icon {{item.icon}}"></view>
                    <view class="item-info">
                        <text class="item-title">{{item.title}}</text>
                        <text class="item-desc">{{item.desc}}</text>
                    </view>
                    <text wx:if="{{item.arrow}}" class="item-arrow">›</text>
                </view>
            </view>
        </view>

        <!-- 退出登录按钮 -->
        <view
            class="logout-button {{isLoggingOut ? 'is-disabled' : ''}}"
            bindtap="handleLogout"
        >
            退出登录
        </view>

        <view class="bottom-spacer"></view>
    </scroll-view>

    <!-- 修改昵称弹窗 -->
    <view wx:if="{{showEditModal}}" class="modal-mask" bindtap="closeEdit">
        <view class="modal-card" catchtap="">
            <text class="modal-title">修改昵称</text>
            <input
                class="name-input"
                type="text"
                maxlength="12"
                placeholder="请输入昵称"
                value="{{draftName}}"
                bindinput="onNameInput"
                bindconfirm="saveName"
                focus="{{showEditModal}}"
            />
            <view class="modal-actions">
                <view class="modal-button ghost" bindtap="closeEdit">取消</view>
                <view
                    class="modal-button primary {{isSaving ? 'is-disabled' : ''}}"
                    bindtap="saveName"
                >
                    保存
                </view>
            </view>
        </view>
    </view>
</view>
