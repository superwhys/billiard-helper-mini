<!--pages/login/login.wxml-->
<view class="page">
    <view class="content">
        <!-- Logo 区域 -->
        <view class="logo-area">
            <view class="logo-circle">
                <text class="logo-icon">🎱</text>
            </view>
            <text class="app-name">台球计分助手</text>
            <text class="app-desc">记录每一场精彩对局</text>
        </view>

        <!-- 登录按钮 -->
        <view class="action-area">
            <view
                class="login-button {{isLoading ? 'is-disabled' : ''}}"
                bindtap="handleWxLogin"
            >
                <text class="login-text">{{isLoading ? '登录中...' : '微信一键登录'}}</text>
            </view>
            <text class="login-tip">登录即表示同意相关服务协议</text>
        </view>
    </view>
</view>
