/* pages/about/about.wxss */
.page {
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: linear-gradient(180deg, #0c1e17 0%, #0a1a14 50%, #081410 100%);
}

.scroll-area {
    flex: 1;
    height: 100%;
    padding: 24rpx 36rpx 0;
}

.hero {
    padding: 36rpx;
    border-radius: 36rpx;
    background: rgba(19, 33, 29, 0.95);
    border: 2rpx solid rgba(72, 108, 94, 0.6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12rpx;
    margin-bottom: 28rpx;
    box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.25);
}

.logo {
    width: 96rpx;
    height: 96rpx;
    border-radius: 24rpx;
    background: rgba(44, 112, 79, 0.9);
    border: 2rpx solid rgba(98, 214, 151, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #e7f5f1;
    font-weight: 700;
    font-size: 40rpx;
}

.app-name {
    font-size: 32rpx;
    font-weight: 600;
    color: #e6f5ef;
}

.app-desc {
    font-size: 24rpx;
    color: rgba(218, 239, 231, 0.65);
}

.card {
    padding: 28rpx;
    border-radius: 32rpx;
    border: 2rpx solid rgba(70, 108, 94, 0.6);
    background: rgba(19, 33, 29, 0.9);
    display: flex;
    flex-direction: column;
    gap: 18rpx;
    margin-bottom: 24rpx;
}

.section-title {
    font-size: 28rpx;
    font-weight: 600;
    color: rgba(231, 245, 241, 0.85);
}

.section-desc {
    font-size: 24rpx;
    color: rgba(218, 239, 231, 0.6);
}

.info-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16rpx;
    padding: 10rpx 0;
    border-top: 2rpx solid rgba(42, 64, 57, 0.75);
}

.info-row:first-of-type {
    border-top: none;
    padding-top: 0;
}

.info-label {
    font-size: 26rpx;
    color: rgba(218, 239, 231, 0.7);
}

.info-value {
    font-size: 26rpx;
    color: #e6f5ef;
}

.feature-list {
    display: flex;
    flex-direction: column;
    gap: 8rpx;
}

.feature-item {
    font-size: 24rpx;
    color: rgba(218, 239, 231, 0.65);
}

.bottom-spacer {
    height: 160rpx;
}
