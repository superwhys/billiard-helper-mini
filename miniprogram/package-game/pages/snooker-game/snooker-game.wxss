.page {
    padding: 24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
}
.card {
    padding: 28rpx;
    margin-bottom: 24rpx;
    border: 1rpx solid #264136;
    border-radius: 24rpx;
    background: #10251c;
}
.empty-state {
    padding: 64rpx 28rpx;
    text-align: center;
}
.empty-state .button { margin-top: 28rpx; }
.eyebrow {
    color: #6ad697;
    font-size: 22rpx;
    letter-spacing: 4rpx;
}
.room-name {
    display: block;
    margin: 8rpx 0 20rpx;
    font-size: 38rpx;
    font-weight: 600;
    word-break: break-all;
}
.heading-meta, .section-head, .actions, .frame-totals, .frame-row, .switch-field {
    display: flex;
    align-items: center;
    gap: 16rpx;
}
.heading-meta { flex-wrap: wrap; }
.tag {
    padding: 6rpx 18rpx;
    border-radius: 30rpx;
    background: #244835;
    color: #83e3a8;
    font-size: 24rpx;
}
.muted, .unit {
    color: #98b3a6;
    font-size: 24rpx;
}
.unit { margin-left: 6rpx; font-weight: 400; }
.message { display: block; margin: 0 0 24rpx; }
.message .muted { display: block; margin-top: 8rpx; }
.error-text { color: #ff969b; font-size: 26rpx; }
.table-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24rpx;
}
.stat > text { display: block; }
.stat-value { margin-top: 4rpx; font-size: 44rpx; font-weight: 600; }
.section-head { justify-content: space-between; flex-wrap: wrap; }
.section-title { display: block; font-size: 30rpx; font-weight: 600; word-break: break-all; }
button { margin: 0; padding: 0; color: #e7f5f1; border-radius: 16rpx; font-size: 27rpx; line-height: 1.5; }
button::after { border: none; }
/* 覆盖微信原生 button[disabled]:not([type]) 的浅色禁用样式。 */
.page button.ball-button[disabled],
.page button.button[disabled],
.page button.player[disabled],
.page button.text-button[disabled] { color: #a1b3aa; opacity: 0.45; }
.player {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 24rpx;
    margin-top: 20rpx;
    background: #142d23;
    border: 2rpx solid transparent;
    text-align: left;
}
.player.selected { border-color: #65c58d; background: #203d2c; }
.page button.player[disabled] { background: #142d23; }
.page button.player.selected[disabled] { background: #203d2c; }
.player-info { flex: 1; min-width: 0; }
.player-info > text { display: block; }
.player-name { margin-bottom: 4rpx; font-size: 30rpx; word-break: break-all; }
.player-score { margin-left: 12rpx; font-size: 48rpx; font-weight: 600; white-space: nowrap; }
.lead-text { display: block; margin-top: 20rpx; }
.target-hint { display: block; margin: 12rpx 0 24rpx; color: #8fe4ac; font-size: 26rpx; }
.ball-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12rpx; }
.ball-button { padding: 18rpx 4rpx; background: #193629; }
.page button.ball-button[disabled] { background: #15291f; opacity: 0.38; }
.ball {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 70rpx;
    height: 70rpx;
    margin: 0 auto 12rpx;
    border-radius: 50%;
    background-image: radial-gradient(circle at 30% 25%, #ffffff50, transparent 55%);
    border: 1rpx solid #ffffff30;
    box-shadow: inset -5rpx -7rpx 12rpx #00000040, 0 6rpx 10rpx #00000030;
    color: #fff;
    font-size: 29rpx;
    text-shadow: 0 1rpx 5rpx #00000080;
}
.ball-name, .ball-button .muted { display: block; font-size: 23rpx; }
.button { display: block; width: 100%; padding: 22rpx 16rpx; background: #233f31; border: 1rpx solid #365a43; }
.page button.button[disabled] { background: #233f31; }
.primary { background: #6ad697; color: #092818; border-color: #6ad697; font-weight: 600; }
.danger { color: #ffb2a7; background: #412a24; border-color: #715047; }
.page button.danger[disabled] { background: #412a24; }
.turn-button { margin: 24rpx 0 16rpx; }
.actions { align-items: stretch; }
.actions > button { flex: 1; min-width: 0; }
.notice { display: block; min-height: 64rpx; margin-top: 20rpx; color: #8bd9a7; font-size: 24rpx; }
.frame-totals { margin: 24rpx 0; justify-content: space-between; }
.frame-totals > text:not(.frame-score) { flex: 1; min-width: 0; word-break: break-all; font-size: 26rpx; }
.frame-totals > text:last-child { text-align: right; }
.frame-score { font-size: 48rpx; font-weight: 600; white-space: nowrap; }
.frame-row { padding-top: 20rpx; margin-top: 20rpx; border-top: 1rpx solid #294737; font-size: 24rpx; }
.frame-row > text { flex: 1; min-width: 0; }
.frame-winner { text-align: right; word-break: break-all; color: #98b3a6; }
.settlement-note { display: block; margin: 18rpx 0 24rpx; }
.text-button { background: transparent; color: #b5cfc1; font-size: 25rpx; }
.page button.text-button[disabled] { background: transparent; }
.refresh-button { margin-left: auto; padding: 8rpx 12rpx; }
.concede-button { display: block; width: 100%; margin-top: 20rpx; padding: 12rpx; }
.rules-note { line-height: 1.8; padding: 0 8rpx; }
.modal-mask {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24rpx;
    background: #000000b3;
}
.modal-card {
    width: 100%;
    max-height: 85vh;
    overflow-y: auto;
    padding: 32rpx;
    border: 1rpx solid #3a5c46;
    border-radius: 28rpx;
    background: #142b20;
}
.modal-desc { display: block; margin: 24rpx 0; word-break: break-all; }
.penalty-options { margin-bottom: 24rpx; }
.penalty-options .button { display: block; width: 100%; padding: 20rpx 8rpx; }
.chosen { border-color: #6ad697; color: #91e6b2; background: #2d513b; }
.field-label { display: block; font-size: 25rpx; margin-bottom: 12rpx; }
.number-input { width: 100%; height: 88rpx; padding: 0 24rpx; background: #203d2c; border: 1rpx solid #49634d; border-radius: 16rpx; }
.switch-field { margin: 24rpx 0; justify-content: space-between; font-size: 25rpx; }
.switch-field > text { flex: 1; }
.modal-actions { margin-top: 28rpx; }
