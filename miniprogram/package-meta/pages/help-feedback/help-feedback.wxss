/* pages/help-feedback/help-feedback.wxss */
.page {
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: linear-gradient(180deg, #0c1e17 0%, #0a1a14 50%, #081410 100%);
}

.scroll-area {
    flex: 1;
    height: 100%;
    padding: 24rpx 36rpx 0;
}

.hero {
    padding: 32rpx;
    border-radius: 36rpx;
    background: rgba(19, 33, 29, 0.95);
    border: 2rpx solid rgba(72, 108, 94, 0.6);
    display: flex;
    flex-direction: column;
    gap: 10rpx;
    margin-bottom: 28rpx;
    box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.25);
}

.hero-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #e6f5ef;
}

.hero-desc {
    font-size: 24rpx;
    color: rgba(218, 239, 231, 0.65);
}

.card {
    padding: 28rpx;
    border-radius: 32rpx;
    border: 2rpx solid rgba(70, 108, 94, 0.6);
    background: rgba(19, 33, 29, 0.9);
    display: flex;
    flex-direction: column;
    gap: 20rpx;
    margin-bottom: 24rpx;
}

.section-title {
    font-size: 28rpx;
    font-weight: 600;
    color: rgba(231, 245, 241, 0.85);
}

.section-desc {
    font-size: 24rpx;
    color: rgba(218, 239, 231, 0.6);
}

.feedback-box {
    border-radius: 24rpx;
    padding: 20rpx;
    background: rgba(13, 25, 21, 0.7);
    border: 2rpx solid rgba(72, 108, 94, 0.4);
    display: flex;
    flex-direction: column;
    gap: 16rpx;
}

.feedback-input {
    width: 100%;
    min-height: 200rpx;
    padding: 18rpx 20rpx;
    border-radius: 20rpx;
    border: 2rpx solid rgba(72, 108, 94, 0.5);
    background: rgba(16, 28, 24, 0.9);
    color: #e7f5f1;
    font-size: 24rpx;
    line-height: 1.6;
    box-sizing: border-box;
    display: block;
}

.feedback-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16rpx;
}

.feedback-count {
    font-size: 22rpx;
    color: rgba(218, 239, 231, 0.55);
}

.submit-button {
    padding: 14rpx 30rpx;
    border-radius: 999rpx;
    background: rgba(52, 92, 75, 0.95);
    color: #e6f5ef;
    font-size: 24rpx;
    font-weight: 600;
    line-height: 1.2;
}

.submit-button::after {
    display: none;
}

.submit-button.is-disabled {
    opacity: 0.6;
}

.faq-item {
    display: flex;
    flex-direction: column;
    gap: 8rpx;
    padding: 16rpx 0;
    border-top: 2rpx solid rgba(42, 64, 57, 0.75);
}

.faq-item:first-of-type {
    border-top: none;
    padding-top: 0;
}

.faq-question {
    font-size: 26rpx;
    font-weight: 600;
    color: #e6f5ef;
}

.faq-answer {
    font-size: 24rpx;
    color: rgba(218, 239, 231, 0.65);
}

.tips {
    border-radius: 24rpx;
    padding: 20rpx;
    background: rgba(13, 25, 21, 0.7);
    border: 2rpx solid rgba(72, 108, 94, 0.4);
    display: flex;
    flex-direction: column;
    gap: 8rpx;
}

.tip-title {
    font-size: 24rpx;
    font-weight: 600;
    color: rgba(231, 245, 241, 0.85);
}

.tip-item {
    font-size: 23rpx;
    color: rgba(218, 239, 231, 0.65);
}

.bottom-spacer {
    height: 160rpx;
}
